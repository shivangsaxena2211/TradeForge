# PostgreSQL connection string
DATABASE_URL=

# Auth.js session secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-generated-secret"

# Local Anvil / Ethereum-compatible RPC endpoint
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Chain ID (31337 is the default for Anvil)
CHAIN_ID=31337

# Browser-side blockchain access (same local values as above)
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337

# Market simulation (Phase 16)
MARKET_SIMULATION_AUTO_START=false
ALLOW_SIMULATION_CONTROL=true

# Anvil admin private key for local contract scripts and price sync (dev only — never commit)
ANVIL_ADMIN_PRIVATE_KEY= 

# Legacy alias (optional): BLOCKCHAIN_ADMIN_PRIVATE_KEY=
