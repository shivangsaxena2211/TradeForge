{
  "name": "definn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "blockchain:start": "anvil --host 127.0.0.1 --port 8545 --chain-id 31337",
    "blockchain:build": "forge build && node scripts/extract-contract-artifacts.mjs",
    "blockchain:deploy": "forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast --unlocked --sender 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 && node scripts/extract-contract-artifacts.mjs",
    "blockchain:test": "forge test -vvv",
    "market:simulate": "npx tsx scripts/update-simulated-prices.ts",
    "market:seed-universe": "npx tsx scripts/seed-stock-universe.ts",
    "market:import": "npx tsx scripts/import-market-data.ts",
    "trading:setup-on-chain": "npx tsx scripts/setup-on-chain-trading.ts",
    "trading:verify-on-chain": "npx tsx scripts/verify-on-chain-trading.ts",
    "start:local": "npx tsx scripts/start-local.ts",
    "demo:fund": "npx tsx scripts/fund-demo-wallet.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "ethers": "^6.17.0",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
